# Copy to keystore.properties (gitignored) to produce a signed release build.
#
# Create a keystore first:
#   keytool -genkeypair -v -keystore kontroller.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias kontroller
#
# An existing keystore keeps whatever alias it was created with: the alias cannot be
# renamed, and signing a release with a different key stops users upgrading. Only use the
# names above for a keystore you are creating from scratch.
#
# storeFile is resolved relative to the repository root. Keep the keystore itself out of
# the repository.

storeFile=kontroller.jks
storePassword=
keyAlias=kontroller
keyPassword=
