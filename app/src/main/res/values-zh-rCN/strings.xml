    <string name="setting_gyro_title">体感鼠标</string>
    <string name="setting_gyro_summary">通过倾斜手机移动指针，而不是在触控板上滑动。轻点、滚动和点击按钮仍可正常使用。</string>
    <string name="setting_gyro_invert_x">反转左右</string>
    <string name="setting_gyro_invert_y">反转上下</string>
    <string name="setting_gyro_invert_summary">如果方向与你握持手机的方式不符，可反转任一轴。</string>

    <string name="setting_host_layout_title">电脑的键盘布局</string>
    <string name="setting_host_layout_summary">指你所控制电脑上的布局，而非本手机的布局。蓝牙传输的是按键位置而不是字符，因此该设置必须与电脑一致，否则字母和标点会错位。使用中文、韩文、印地文、阿拉伯文、泰文和越南文的电脑均使用美式 QWERTY，文字由电脑端的输入法生成。</string>

    <string name="setting_language_title">应用语言</string>
    <string name="setting_language_summary">本应用的显示语言，不影响发送到电脑的内容。</string>

    <string name="setting_click_bar_title">点击按钮</string>
    <string name="setting_click_bar_summary">在触控板下方显示左键和右键，与笔记本电脑类似。按住按钮并在触控板上滑动即可拖放。触控板会相应缩小。</string>

    <string name="setting_auto_pair_title">自动连接</string>
    <string name="setting_auto_pair_summary">应用启动后由手机主动连接已知的电脑。比从电脑端连接更可靠，因为电脑端往往会选择音频配置文件。</string>

    <string name="setting_stay_connected_title">后台保持连接</string>
    <string name="setting_stay_connected_summary">离开应用或息屏后仍继续作为键盘和鼠标使用，期间会显示常驻通知。</string>

