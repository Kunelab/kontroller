<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the Anko `verticalLayout { textView { ... } }` DSL that upstream built
     in code. Anko is archived and cannot be used with modern Kotlin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- No background: the pad is just the empty area above the separator.
         height 0dp + weight 1 means it gives up exactly the space the click bar takes,
         so enabling the bar shrinks the pad automatically. -->
    <io.github.kunelab.kontroller.TrackpadView
        android:id="@id/mouseView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/trackpad_label"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Media / consumer keys, for using the phone as a TV-style remote. -->
    <LinearLayout
        android:id="@+id/mediaBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mediaVolDown"
                style="@style/RemoteKey"
                android:text="@string/media_vol_down" />

            <View style="@style/RemoteDivider" />

            <TextView
                android:id="@+id/mediaVolUp"
                style="@style/RemoteKey"
                android:text="@string/media_vol_up" />

            <View style="@style/RemoteDivider" />

            <TextView
                android:id="@+id/mediaMute"
                style="@style/RemoteKey"
                android:text="@string/media_mute" />

            <View style="@style/RemoteDivider" />

            <TextView
                android:id="@+id/mediaPrev"
                style="@style/RemoteKey"
                android:text="@string/media_prev" />

            <View style="@style/RemoteDivider" />

            <TextView
                android:id="@+id/mediaPlay"
                style="@style/RemoteKey"
                android:text="@string/media_play" />

            <View style="@style/RemoteDivider" />

            <TextView
                android:id="@+id/mediaNext"
                style="@style/RemoteKey"
                android:text="@string/media_next" />

            <View style="@style/RemoteDivider" />

            <TextView
                android:id="@+id/mediaHome"
                style="@style/RemoteKey"
                android:text="@string/media_home" />
        </LinearLayout>
    </LinearLayout>

    <!-- Physical-trackpad-style click buttons. Press and hold either one and drag on the
         pad above to drag and drop, exactly like a laptop touchpad. -->
    <LinearLayout
        android:id="@+id/clickBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/leftClickButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/click_button"
                android:contentDescription="@string/click_left"
                android:gravity="center"
                android:text="@string/click_left"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/separator" />

            <TextView
                android:id="@+id/rightClickButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/click_button"
                android:contentDescription="@string/click_right"
                android:gravity="center"
                android:text="@string/click_right"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
