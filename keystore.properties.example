# Copy to keystore.properties (gitignored) to produce a signed release build.
#
# Create a keystore first:
#   keytool -genkeypair -v -keystore maxkontroller.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias maxkontroller
#
# storeFile is resolved relative to the repository root. Keep the keystore itself out of
# the repository.

storeFile=maxkontroller.jks
storePassword=
keyAlias=maxkontroller
keyPassword=
